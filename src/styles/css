body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f4f4f4;
}

.app {
  display: flex;
  height: 100vh;
}

.left-panel {
  width: 70%;
  padding: 20px;
  overflow-y: auto;
}

.right-panel {
  width: 30%;
  background: white;
  border-left: 1px solid #ddd;
  padding: 20px;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
}

.total {
  margin-top: 20px;
  font-size: 24px;
  font-weight: bold;
}

.pay-button {
  width: 100%;
  padding: 15px;
  border: none;
  border-radius: 8px;
  background: green;
  color: white;
  font-size: 20px;
  cursor: pointer;
}